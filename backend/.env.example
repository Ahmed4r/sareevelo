# Local development; use your existing PostgreSQL credentials.
DB_URL=jdbc:postgresql://localhost:5432/sareevelo_db
DB_USER=
DB_PASSWORD=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Only needed for SPRING_PROFILES_ACTIVE=production behind HTTPS.
# Password values must be BCrypt hashes with cost 10-16, not plaintext.
DISPATCHER_USER=
DISPATCHER_PASSWORD_HASH=
VIEWER_USER=
VIEWER_PASSWORD_HASH=
